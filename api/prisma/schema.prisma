// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Product {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String
  price          Decimal
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  imageUrl       String?
  specifications Json      @default("[]")
  featured       Boolean   @default(false)
  active         Boolean   @default(true)
  displayOnSite  Boolean   @default(true)
  sortOrder      Int       @default(0)
  requests       Request[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("products")
}

model Service {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String
  price         String
  category      String   @default("diagnostics")
  icon          String?
  duration      String?
  warranty      Boolean  @default(false)
  featured      Boolean  @default(false)
  active        Boolean  @default(true)
  displayOnSite Boolean  @default(true)
  sortOrder     Int      @default(0)
  requests      Request[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("services")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  role         UserRole  @default(USER)
  passwordHash String?
  telegramId   String?   // Для привязки Telegram
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  authSessions AuthSession[]
  twoFactorAuth TwoFactorAuth?

  @@map("users")
}

model Request {
  id        String      @id @default(cuid())
  name      String
  phone     String
  email     String?
  type      RequestType
  productId String?
  product   Product?    @relation(fields: [productId], references: [id])
  serviceId String?
  service   Service?    @relation(fields: [serviceId], references: [id])
  message   String?
  status    RequestStatus @default(NEW)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("requests")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  email            String
  token            String    @unique
  isActive         Boolean   @default(true)
  twoFactorCode    String?   // Временный код для 2FA
  twoFactorExpires DateTime? // Срок действия кода 2FA
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model TwoFactorAuth {
  id          String   @id @default(cuid())
  userId      String   @unique
  email       String
  secret      String   // Секрет для Google Authenticator
  backupCodes String[] // Резервные коды
  isEnabled   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auth")
}

model ApiKey {
  id        String    @id @default(cuid())
  name      String
  key       String    @unique
  allowedIps String[] @default([])
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("api_keys")
}

// Компоненты для 3D конструктора
model Component {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?  // English name
  slug          String   @unique
  category      ComponentCategory
  description   String?
  descriptionEn String?  // English description

  // 3D модель
  model3DUrl    String?
  thumbnailUrl  String?
  position      Json?    // [x, y, z]
  rotation      Json?    // [x, y, z]
  scale         Json?    // [x, y, z]

  // Характеристики
  specifications Json    @default("{}")

  // Цена и наличие
  price         Decimal
  stock         Int      @default(0)

  // Совместимость
  compatibleWith String[] // ID совместимых компонентов

  // Статус
  active        Boolean  @default(true)
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)

  // Узлы к которым относится
  assemblyNodes AssemblyNode[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("components")
}

// Узлы сборки гриндера
model AssemblyNode {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?  // English name
  slug          String   @unique
  nodeType      String   // base, frame, motor, etc.
  description   String?
  descriptionEn String?  // English description

  // Обязательность
  isRequired    Boolean  @default(true)

  // Порядок отображения
  sortOrder     Int      @default(0)

  // Компоненты в узле
  components    Component[]

  // Точки крепления
  mountPoints   Json?    // Array of mount points

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("assembly_nodes")
}

// Сохраненные конфигурации конструктора
model GrinderConfig {
  id              String   @id @default(cuid())
  name            String
  description     String?
  
  // Выбранные компоненты
  configuration   Json     // { nodeType: componentId }
  
  // Расчет цены
  basePrice       Decimal  @default(0)
  componentsTotal Decimal  @default(0)
  discount        Decimal  @default(0)
  totalPrice      Decimal  @default(0)
  
  // Пользователь (опционально)
  userId          String?
  
  // Статус
  isPublic        Boolean  @default(false)
  isPreset        Boolean  @default(false)
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("grinder_configs")
}

enum ComponentCategory {
  BASE
  FRAME
  MOTOR
  DRIVE_ROLLER
  IDLER_ROLLER
  TENSIONER
  BELT
  GUARD
  ACCESSORY
}

enum UserRole {
  USER
  ADMIN
}

enum RequestType {
  PRODUCT
  SERVICE
}

enum RequestStatus {
  NEW
  PROCESSING
  COMPLETED
  CANCELLED
}
